VITE_API_URL=http://localhost:4000/api/v1
# Production: must match platform Public App URL (e.g. https://www.nodexpro.com) for DocFlow portal canonical redirect + cookies.
# VITE_PUBLIC_APP_URL=https://www.nodexpro.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
# Supabase Dashboard → Authentication → URL configuration: add redirect URL(s) for password reset, e.g.
# https://www.nodexpro.com/reset-password and http://localhost:3000/reset-password
#
# Vercel (per project — do not put real hosts in git):
#   VITE_API_URL=/api/v1
#   API_REWRITE_ORIGIN=https://<this-env-render-host>
#     PROD example: https://nodexpro.onrender.com
#     DEV example:  https://nodexpro-api-dev.onrender.com
# apps/web/vercel.json proxies /api/v1/* to ${API_REWRITE_ORIGIN}/api/v1/*.
# Same-origin SPA calls; no hardcoded Render URL in the repo.
